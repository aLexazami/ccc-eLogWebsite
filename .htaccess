# Disable directory browsing
Options -Indexes

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to protected directories
    RewriteRule ^(config|classes|includes|node_modules)(/|$) - [F,L]
</IfModule>

# Block access to sensitive files
<FilesMatch "^(package\.json|package-lock\.json|\.gitignore)$">
    Require all denied
</FilesMatch>